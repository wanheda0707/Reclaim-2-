# Microsoft Graph app-only mail delivery (PLM Outlook)
# Create an Entra ID app, grant Microsoft Graph Mail.Send application permission,
# and have an administrator grant tenant-wide consent. Use a permitted PLM mailbox.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=

# Optional API listener override
# API_PORT=3001

# Optional server-only Supabase admin role lookup. Never prefix the key with VITE_.
SUPABASE_URL=https://sqicephynnalidwgbxof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase settings. Use the project's public publishable or anon key.
VITE_SUPABASE_URL=https://sqicephynnalidwgbxof.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
